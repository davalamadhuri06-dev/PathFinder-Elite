<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp" />
            <gradient
                android:startColor="#E2E8F0"
                android:centerColor="#E2E8F0"
                android:endColor="#E2E8F0"
                android:angle="0" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4dp" />
                <gradient
                    android:startColor="@color/primary_accent"
                    android:centerColor="@color/primary_accent"
                    android:endColor="@color/primary_accent"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
