<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Selection UI -->
    <LinearLayout
        android:id="@+id/layoutThemeSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Elite Tracks"
            android:textColor="@color/text_title"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select the skills you want to evaluate today."
            android:textColor="@color/text_body"
            android:layout_marginBottom="40dp"
            android:gravity="center"/>

        <CheckBox
            android:id="@+id/cbCoding"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="💻 Coding &amp; Logic"
            android:textColor="@color/text_title"
            android:background="@drawable/floating_nav_bg"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:buttonTint="@color/primary_accent"/>

        <CheckBox
            android:id="@+id/cbCommunication"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="🤝 Communication &amp; Leadership"
            android:textColor="@color/text_title"
            android:background="@drawable/floating_nav_bg"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="40dp"
            android:buttonTint="@color/primary_accent"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="GENERATE ASSESSMENT"
            android:backgroundTint="@color/primary_accent"
            android:fontFamily="sans-serif-black"
            app:cornerRadius="20dp"/>
    </LinearLayout>

    <!-- Question UI -->
    <LinearLayout
        android:id="@+id/layoutQuestionArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUESTION 1/5"
            android:textColor="@color/primary_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.2"/>

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="@color/text_title"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"/>

        <RadioGroup
            android:id="@+id/rgOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <RadioButton android:id="@+id/rbOpt1" android:layout_width="match_parent" android:layout_height="64dp" android:text="Option 1" android:textColor="@color/text_body" android:paddingHorizontal="20dp" android:background="@drawable/floating_nav_bg" android:layout_marginBottom="12dp" android:button="@null"/>
            <RadioButton android:id="@+id/rbOpt2" android:layout_width="match_parent" android:layout_height="64dp" android:text="Option 2" android:textColor="@color/text_body" android:paddingHorizontal="20dp" android:background="@drawable/floating_nav_bg" android:layout_marginBottom="12dp" android:button="@null"/>
            <RadioButton android:id="@+id/rbOpt3" android:layout_width="match_parent" android:layout_height="64dp" android:text="Option 3" android:textColor="@color/text_body" android:paddingHorizontal="20dp" android:background="@drawable/floating_nav_bg" android:button="@null"/>
        </RadioGroup>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/btnNextAssessment"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="NEXT"
            android:backgroundTint="@color/primary_accent"
            android:fontFamily="sans-serif-black"
            app:cornerRadius="20dp"/>
    </LinearLayout>

    <!-- Score Card -->
    <LinearLayout
        android:id="@+id/layoutScoreCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏁" android:textSize="80sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ELITE SCORECARD" android:textColor="@color/text_title" android:fontFamily="sans-serif-black" android:textSize="22sp" android:layout_marginTop="24dp"/>
        <TextView android:id="@+id/tvFinalScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Score: 85%" android:textColor="@color/primary_accent" android:textSize="24sp" android:fontFamily="sans-serif-black" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/tvScoreMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Message..." android:gravity="center" android:textColor="@color/text_body" android:layout_marginTop="16dp"/>
        <Button android:id="@+id/btnBackToProfile" android:layout_width="match_parent" android:layout_height="64dp" android:text="EXIT" android:layout_marginTop="48dp" android:backgroundTint="@color/accent_vibrant" android:fontFamily="sans-serif-black" app:cornerRadius="20dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
