<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/headerBase"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="60dp"
        android:text="Elite Portfolio"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-black"
        android:textSize="28sp"
        android:letterSpacing="-0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Digital ID Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardID"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvProfileTitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_gradient"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELITE PATHFINDER"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELITE STUDENT"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintBottom_toTopOf="@id/tvProfileEmail"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textColor="#B0BEC5"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/ivProfilePic"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_badge"
                android:background="@drawable/floating_nav_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/secondary_accent"
                android:fontFamily="sans-serif-black"
                android:textSize="10sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvBadgesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_badges"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardID"
        app:layout_constraintStart_toStartOf="@id/cardID"/>

    <LinearLayout
        android:id="@+id/layoutBadges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvBadgesLabel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_explorer"
            android:background="@drawable/floating_nav_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_title"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_thinker"
            android:background="@drawable/floating_nav_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_title"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"/>

    </LinearLayout>

    <!-- Form Access Section -->
    <LinearLayout
        android:id="@+id/layoutForms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutBadges">

        <Button
            android:id="@+id/btnGoFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GIVE FEEDBACK"
            android:backgroundTint="@color/accent_vibrant"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:textSize="14sp"
            app:cornerRadius="16dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elite Career Tracker"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutForms"
        app:layout_constraintStart_toStartOf="@id/cardID"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatusLabel">

        <LinearLayout
            android:id="@+id/layoutAppStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="100dp">

            <!-- Sample Milestone Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/premium_card_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Verified"
                        android:textColor="@color/black"
                        android:fontFamily="sans-serif-black"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome to the Elite Pathfinder Network. Your journey has begun!"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Dynamic entries will be added here -->
            <TextView
                android:id="@+id/tvNoApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanning for additional milestones..."
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
