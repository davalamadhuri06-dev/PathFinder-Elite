<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <View
        android:id="@+id/headerBase"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRoadmapTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="60dp"
        android:text="Blueprint Depth"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-black"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBase">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <!-- Deep Dive Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardElevation="10dp">
                <LinearLayout
                    android:padding="28dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/premium_card_bg">

                    <TextView
                        android:id="@+id/tvDetailHeading"
                        android:text="Career Deep Dive"
                        android:fontFamily="sans-serif-black"
                        android:textSize="22sp"
                        android:textColor="@color/primary_accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Loading elite intelligence..."
                        android:textColor="@color/text_body"
                        android:lineSpacingExtra="6dp"
                        android:textSize="15sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="24dp"/>

                    <TextView
                        android:text="TOP INSTITUTIONS"
                        android:fontFamily="sans-serif-black"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"
                        android:textColor="@color/text_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvDetailInstitutions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• Tier 1 Institutes"
                        android:textColor="@color/text_title"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>

                    <TextView
                        android:text="\nEXPECTED GROWTH"
                        android:fontFamily="sans-serif-black"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"
                        android:textColor="@color/text_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvDetailGrowth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="High growth potential in next 10 years."
                        android:textColor="@color/text_title"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
