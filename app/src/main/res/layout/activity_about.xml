<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <View
        android:id="@+id/headerBase"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAboutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="60dp"
        android:text="The Mission"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-black"
        android:textSize="28sp"
        android:letterSpacing="-0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_dots"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Menu" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBase">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp">
                <LinearLayout android:padding="32dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/premium_card_bg">
                    <TextView android:text="SDG 4: Quality Education" android:fontFamily="sans-serif-black" android:textSize="20sp" android:textColor="@color/primary_accent" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="PathFinder is dedicated to achieving Sustainable Development Goal 4. Our goal is to provide rural and village students with elite career intelligence, bridging the gap between local talent and global opportunities." android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:lineSpacingExtra="6dp" android:textColor="@color/text_body" android:textSize="15sp"/>

                    <TextView android:text="\nDeveloper Strategy" android:fontFamily="sans-serif-black" android:textSize="18sp" android:textColor="@color/text_title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Developed as a high-impact CSP project to architect the next generation of career guidance systems." android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_body" android:textSize="15sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
