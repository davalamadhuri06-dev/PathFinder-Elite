    <!-- Career Details Labels -->
    <string name="label_roadmap">📍 Career Roadmap</string>
    <string name="label_day_in_life">🕒 A Day in the Life</string>

    <!-- Science Roadmap & Day in Life -->
    <string name="career_sci_roadmap">10th (MPC/BiPC) → 12th Board → Entrance (JEE/NEET) → Specialization → Professional Career</string>
    <string name="career_sci_day">Morning: Lab experiments or coding sessions.\nAfternoon: Analyzing data and research reports.\nEvening: Project documentation and learning new tech.</string>

    <!-- Commerce Roadmap & Day in Life -->
    <string name="career_com_roadmap">10th (Commerce) → 12th → Professional Course (CA/CS) or Graduation → MBA → Business Leader</string>
    <string name="career_com_day">Morning: Checking market trends and financial emails.\nAfternoon: Client meetings and audit reports.\nEvening: Balancing accounts and strategic planning.</string>

    <!-- Arts Roadmap & Day in Life -->
    <string name="career_art_roadmap">10th (Humanities) → 12th → Creative Degree (Design/Law) → Portfolio Building → Impactful Career</string>
    <string name="career_art_day">Morning: Creative brainstorming or case study reading.\nAfternoon: Designing prototypes or field research.\nEvening: Networking and presenting vision to stakeholders.</string>

    <!-- Trending Details Extensions -->
    <string name="career_ai_roadmap">10th (MPC) → B.Tech CS → Learn Python → Certifications → Engineer at Big Tech</string>
    <string name="career_ai_day">Morning: Debugging ML models and training data.\nAfternoon: Architecture meetings and algorithm tuning.\nEvening: Deployment tracking and GitHub contributions.</string>

    <string name="career_energy_roadmap">10th (MPC) → B.Tech Electrical/Mechanical → M.Tech Green Tech → Renewable Industry Specialist</string>
    <string name="career_energy_day">Morning: On-site solar/wind farm inspections.\nAfternoon: Energy efficiency simulations on software.\nEvening: Government policy research and grid planning.</string>

    <string name="career_ux_roadmap">10th (Any) → Design Degree (B.Des) → Psychology Study → Freelancing → UI/UX Lead Designer</string>
    <string name="career_ux_day">Morning: User interview analysis and wireframing.\nAfternoon: High-fidelity visual design and prototyping.\nEvening: Usability testing and developer hand-off.</string>

